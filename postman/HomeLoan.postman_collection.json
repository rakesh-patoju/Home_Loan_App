{
  "info": {
    "name": "Home Loan Basic Auth Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use demoPassword from DEMO-LOGINS.txt. Requests use HTTP Basic; login returns account metadata only. Follow the workflow manually; approval and rejection are alternative branches."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "COPY_FROM_DEMO-LOGINS.txt",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "customer1@homeloan.demo",
      "type": "string"
    },
    {
      "key": "officerEmail",
      "value": "officer1@homeloan.demo",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "officerId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "postman-demo-application-001",
      "type": "string"
    },
    {
      "key": "newCustomerPassword",
      "value": "SET_YOUR_OWN_10_PLUS_CHARACTER_PASSWORD",
      "type": "string"
    },
    {
      "key": "newOfficerPassword",
      "value": "SET_YOUR_OWN_10_PLUS_CHARACTER_PASSWORD",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 Authentication",
      "item": [
        {
          "name": "Customer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Assigned officer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{officerEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": []
              }
            }
          ]
        },
        {
          "name": "Admin login",
