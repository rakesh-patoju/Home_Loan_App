    {
      "name": "3 Submit and track",
      "item": [
        {
          "name": "Submit (keep key for retry; change key for a new application)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/loan-applications",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{customerEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{demoPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanProductId\": 1,\n  \"requestedLoanAmount\": 3000000,\n  \"tenureMonths\": 240,\n  \"monthlyIncome\": 100000,\n  \"employmentType\": \"SALARIED\",\n  \"existingEmi\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "const a=pm.response.json(); pm.collectionVariables.set(\"applicationId\",a.id);",
                  "pm.collectionVariables.set(\"officerId\",a.assignedOfficerId);",
                  "// Fresh seeded demo has officer user IDs 2 and 3. Check admin officers for other databases.",
                  "if (a.assignedOfficerId === 2) pm.collectionVariables.set(\"officerEmail\",\"officer1@homeloan.demo\");",
                  "if (a.assignedOfficerId === 3) pm.collectionVariables.set(\"officerEmail\",\"officer2@homeloan.demo\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loan-applications/my-applications?page=0&size=20&sort=applicationDate,desc",
            "auth": {
