            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": []
              }
            }
          ]
        },
        {
          "name": "Register fictional customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New Demo Customer\",\n  \"email\": \"new-customer@example.test\",\n  \"password\": \"{{newCustomerPassword}}\",\n  \"mobile\": \"9000000099\",\n  \"dateOfBirth\": \"1995-05-01\",\n  \"address\": \"10 Demo Street\",\n  \"employmentType\": \"SALARIED\",\n  \"monthlyIncome\": 100000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
